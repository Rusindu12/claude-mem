{
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules/@electric-sql/**,node_modules/swagger-ui-dist/**,.pgdata*/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/download", "destination": "/api/index" }
  ],
  "headers": [
    {
      "source": "/downloads/(.*)\\.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"NEXORA-AI-v1.0.0.apk\"" }
      ]
    },
    {
      "source": "/downloads/(.*)\\.zip",
      "headers": [
        { "key": "Content-Type", "value": "application/zip" }
      ]
    }
  ]
}
