# ==============================================================================
# NEXORA AI — "INTELLIGENCE WITHOUT LIMITS"
# Production Environment Configuration Template (.env.example)
# NEVER commit real .env files or private keys to version control!
# NEVER place backend secrets inside mobile/.env or Android APK files!
# ==============================================================================

NODE_ENV=production
PORT=4000
PUBLIC_API_URL=https://api.nexora.ai
PUBLIC_WEB_URL=https://app.nexora.ai

# --- Core Security & Encryption Secrets (Generate 32+ byte random strings) ---
JWT_ACCESS_SECRET=CHANGE_ME_64_CHAR_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_64_CHAR_RANDOM_REFRESH_SECRET
# 32-byte key (64 hex chars or 32+ char passphrase) used for AES-256-GCM encryption of AI provider keys at rest
MASTER_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS_AES_256_GCM_MASTER_KEY

# --- Initial Platform Owner Bootstrap (Used once on initial DB seed) ---
OWNER_BOOTSTRAP_EMAIL=owner@nexora.ai
OWNER_BOOTSTRAP_PASSWORD=CHANGE_ME_STRONG_OWNER_PASSWORD

# --- PostgreSQL 16 Primary & Optional Read Replica ---
# Use 'pglite://./data/nexora-pg' for local standalone testing, or standard PostgreSQL URI in production:
DATABASE_URL=postgresql://nexora_app:STRONG_DB_PASSWORD@postgres:5432/nexora_ai?sslmode=prefer
DATABASE_READ_REPLICA_URL=
DB_POOL_MAX=30

# --- Redis 7 (Rate Limiting, Distributed Semaphores, Caching & BullMQ Workers) ---
REDIS_URL=redis://:STRONG_REDIS_PASSWORD@redis:6379/0

# --- S3-Compatible Object Storage (AWS S3 / Cloudflare R2 / MinIO) ---
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
S3_REGION=ap-south-1
S3_BUCKET=nexora-ai-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# --- AI Provider API Credentials (Paid External Accounts — Encrypted in DB via Owner Hub or Loaded Here) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Open-Source / OpenAI-Compatible Inference Endpoint (Groq / Together / DeepSeek / vLLM)
OSS_COMPAT_API_KEY=
OSS_COMPAT_BASE_URL=https://api.groq.com/openai/v1

# --- Sri Lanka LKR Payment Gateway (PayHere Merchant Account Required for Live LKR Checkout) ---
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_CHECKOUT_URL=https://www.payhere.lk/pay/checkout

# --- International USD / Multi-Currency Payment Gateway (Stripe Account Required for Live Cards) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Mobile App Public Build Variable (ONLY non-secret URL goes into Expo / EAS APK build) ---
EXPO_PUBLIC_API_URL=https://api.nexora.ai/api/v1
