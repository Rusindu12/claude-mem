# ==============================================================================
# Axiom Autonomous Agent Configuration
# Never commit real API keys. Copy this file to .env and fill in your secrets.
# ==============================================================================

# Provider selection: auto | axiom-native | anthropic | openai | gemini | local | demo
# - auto: uses configured external API key if provided, otherwise uses built-in Axiom Native AI
AXIOM_PROVIDER=auto

# Model Routing (strongest reasoning model for Planner/Reviewer/hard bugs, faster for routine steps)
AXIOM_REASONING_MODEL=
AXIOM_FAST_MODEL=

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_REASONING_MODEL=claude-sonnet-4-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5

# OpenAI (or OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REASONING_MODEL=gpt-5
OPENAI_FAST_MODEL=gpt-5-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_REASONING_MODEL=gemini-2.5-pro
GEMINI_FAST_MODEL=gemini-2.5-flash

# Local LLM (Ollama / LM Studio / vLLM OpenAI-compatible server)
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=local
LOCAL_LLM_REASONING_MODEL=qwen2.5-coder:32b
LOCAL_LLM_FAST_MODEL=qwen2.5-coder:7b

# Server & Preview Ports
PORT=3000
API_PORT=3001
HOST=0.0.0.0

# Reliability & Cost Budgets
AXIOM_MAX_ITERATIONS=6
AXIOM_MAX_TOOL_STEPS=18
AXIOM_MAX_TOKENS_PER_RUN=180000
AXIOM_MAX_COST_USD_PER_RUN=2.50
AXIOM_LLM_TIMEOUT_MS=45000
AXIOM_CMD_TIMEOUT_MS=30000

# Paths (defaults to ./data and ./workspaces inside agent/)
AXIOM_DATA_DIR=./data
AXIOM_WORKSPACES_DIR=./workspaces
AXIOM_PLUGINS_CONFIG=./plugins/plugins.json
