<?xml version="1.0" encoding="utf-8"?>
<!--
  SHIPPED (release) network policy: HTTPS only.

  Release builds must talk to the backend over TLS. There is deliberately no
  cleartext exception here — not even for 10.0.2.2 or localhost — so a release
  APK can never be pointed at an unencrypted server.

  Debug builds override this file with app/src/debug/res/xml/network_security_config.xml,
  which permits cleartext for local/LAN development backends.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
