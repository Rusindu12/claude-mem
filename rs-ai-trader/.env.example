# =====================================================================
# RS AI TRADER — environment template
# Copy to .env and edit. NEVER commit a real .env.
#   cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------- basics
ENVIRONMENT=development          # development | staging | production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
APP_NAME="RS AI TRADER"

# ---------------------------------------------------------------- security
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
# Generate: python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# REQUIRED in production. Encrypts Binance API secrets at rest (AES-256-GCM).
APP_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
PASSWORD_MIN_LENGTH=12
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY_HEADERS=false

# ---------------------------------------------------------------- storage
POSTGRES_DB=rsai
POSTGRES_USER=rsai
POSTGRES_PASSWORD=change-me-strong-db-password
DATABASE_URL=postgresql+psycopg://rsai:change-me-strong-db-password@localhost:5432/rsai
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- binance
# testnet = https://testnet.binance.vision (sandbox; no real funds)
# live    = https://api.binance.com       (real funds — keep disabled until ready)
BINANCE_ENV=testnet
BINANCE_RECV_WINDOW_MS=5000
BINANCE_TIMEOUT_SECONDS=10
BINANCE_MAX_RETRIES=3
BINANCE_USER_STREAM_ENABLED=true

# ------------------------------------------------------------ market data
MARKET_DATA_MODE=binance         # binance | synthetic
# Allows the UI to keep working (clearly labelled DEMO DATA) if Binance is
# unreachable. Never enable in production.
ALLOW_SYNTHETIC_FALLBACK=false
MARKET_STALE_AFTER_SECONDS=180
MARKET_CACHE_TTL_SECONDS=5
SUPPORTED_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,ADAUSDT
SUPPORTED_TIMEFRAMES=1m,5m,15m,1h,4h,1d

# -------------------------------------------------------- trading safety
LIVE_TRADING_ENABLED=false       # master switch; keep false until the checklist passes
PAPER_TRADING_ENABLED=true
AUTOMATION_ENABLED=false
REQUIRE_MANUAL_APPROVAL=true
DEFAULT_TAKER_FEE_BPS=10
DEFAULT_SLIPPAGE_BPS=5
RISK_ENGINE_ENABLED=true
BACKGROUND_JOBS_ENABLED=true
UVICORN_WORKERS=1                # >1 requires Redis (shared rate limits/cache)

# ------------------------------------------------------------- assistant
ASSISTANT_LLM_ENABLED=false
ASSISTANT_LLM_API_KEY=
ASSISTANT_LLM_MODEL=gpt-4o-mini

# ----------------------------------------------------------- notifications
# Optional: path to a Firebase service-account JSON mounted into the container.
FCM_CREDENTIALS_PATH=
FCM_PROJECT_ID=

# --------------------------------------------------------------- ai engine
AI_ENGINE_PATH=ai-engine
AI_ARTIFACTS_DIR=ai-engine/artifacts
AI_MIN_BARS=210

# ------------------------------------------------------------ rate limits
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_ORDERS_PER_MINUTE=20
